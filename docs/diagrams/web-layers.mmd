---
config:
  theme: base
  fontFamily: "Arial, Helvetica, sans-serif"
  flowchart:
    curve: basis
    padding: 12
    nodeSpacing: 46
    rankSpacing: 26
    subGraphTitleMargin:
      top: 4
      bottom: 10
  class:
    padding: 10
  themeVariables:
    lineColor: "#94a3b8"
    textColor: "#64748b"
    primaryColor: "#f1f5f9"
    primaryBorderColor: "#64748b"
    primaryTextColor: "#0f172a"
    secondaryColor: "#f1f5f9"
    secondaryBorderColor: "#64748b"
    secondaryTextColor: "#0f172a"
    tertiaryColor: "#f1f5f9"
    tertiaryBorderColor: "#64748b"
    tertiaryTextColor: "#0f172a"
    mainBkg: "#f1f5f9"
    nodeBorder: "#64748b"
    nodeTextColor: "#0f172a"
    classText: "#0f172a"
    clusterBkg: "transparent"
    clusterBorder: "#94a3b8"
    titleColor: "#64748b"
    edgeLabelBackground: "#ffffff"
  themeCSS: >
    svg, .label, .nodeLabel, .edgeLabel, foreignObject div { font-family: Arial, Helvetica, sans-serif; }
    .node rect, .node polygon, .node path {
      filter: drop-shadow(0 3px 6px rgba(15, 23, 42, 0.18));
    }
    .node rect { rx: 14px; ry: 14px; }
    .cluster rect { rx: 18px; ry: 18px; }
    .edgeLabel, .edgeLabel p, .edgeLabel span {
      background: #ffffff; color: #475569; border-radius: 999px;
    }
    .edgeLabel p { padding: 3px 10px; }
    .labelBkg { background: transparent !important; fill: none !important; }
---
flowchart TB
    subgraph Views["STATE AND VIEWS"]
        App("<b>App.tsx</b><br/>main.tsx")
        Components("<b>components/</b>")
        Store{{"<b>camera/store.ts</b><br/>zustand"}}
    end

    subgraph CameraLayer["CAMERA"]
        Cam("<b>camera/camera.ts</b><br/>format.ts")
        Pic("<b>camera/picture.ts</b><br/>raw.ts")
    end

    subgraph Transport["TRANSPORT"]
        Conn("<b>ros/connection.ts</b><br/>zustand")
        Ros("<b>ros/rosbridge.ts</b>")
    end

    Settings[("<b>settings.ts</b><br/>zustand, localStorage")]

    App --> Components
    Components --> Store
    Components --> Cam
    Store --> Cam
    Store --> Pic
    Components --> Conn
    Store --> Conn
    Store --> Ros
    Cam -- "type only" --> Ros
    Conn --> Ros
    App --> Settings
    Components --> Settings
    Store --> Settings

    classDef human fill:#ffe4e6,stroke:#e11d48,stroke-width:2px,color:#881337
    classDef voice fill:#ccfbf1,stroke:#0d9488,stroke-width:2px,color:#134e4a
    classDef mind  fill:#ede9fe,stroke:#7c3aed,stroke-width:2px,color:#4c1d95
    classDef brain fill:#7c3aed,stroke:#5b21b6,stroke-width:2px,color:#ffffff
    classDef robot fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#78350f
    classDef data  fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#1e3a8a
    classDef ext   fill:#f1f5f9,stroke:#64748b,stroke-width:2px,color:#0f172a

    class App,Components human
    class Store brain
    class Cam,Pic mind
    class Conn,Ros voice
    class Settings data

    style Views fill:#f43f5e12,stroke:#f43f5e,stroke-width:1.5px,stroke-dasharray:6 5,color:#e11d48
    style CameraLayer fill:#8b5cf612,stroke:#8b5cf6,stroke-width:1.5px,stroke-dasharray:6 5,color:#7c3aed
    style Transport fill:#14b8a612,stroke:#14b8a6,stroke-width:1.5px,stroke-dasharray:6 5,color:#0d9488

    linkStyle 0,1 stroke:#f43f5e,stroke-width:2px
    linkStyle 2,3,4 stroke:#8b5cf6,stroke-width:2px
    linkStyle 5,6,7,8,9 stroke:#14b8a6,stroke-width:2px
    linkStyle 10,11,12 stroke:#3b82f6,stroke-width:2px
