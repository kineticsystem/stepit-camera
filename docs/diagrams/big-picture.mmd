---
config:
  theme: base
  fontFamily: "Arial, Helvetica, sans-serif"
  flowchart:
    curve: basis
    padding: 12
    nodeSpacing: 46
    rankSpacing: 26
    subGraphTitleMargin:
      top: 4
      bottom: 10
  class:
    padding: 10
  themeVariables:
    lineColor: "#94a3b8"
    textColor: "#64748b"
    primaryColor: "#f1f5f9"
    primaryBorderColor: "#64748b"
    primaryTextColor: "#0f172a"
    secondaryColor: "#f1f5f9"
    secondaryBorderColor: "#64748b"
    secondaryTextColor: "#0f172a"
    tertiaryColor: "#f1f5f9"
    tertiaryBorderColor: "#64748b"
    tertiaryTextColor: "#0f172a"
    mainBkg: "#f1f5f9"
    nodeBorder: "#64748b"
    nodeTextColor: "#0f172a"
    classText: "#0f172a"
    clusterBkg: "transparent"
    clusterBorder: "#94a3b8"
    titleColor: "#64748b"
    edgeLabelBackground: "#ffffff"
  themeCSS: >
    svg, .label, .nodeLabel, .edgeLabel, foreignObject div { font-family: Arial, Helvetica, sans-serif; }
    .node rect, .node polygon, .node path {
      filter: drop-shadow(0 3px 6px rgba(15, 23, 42, 0.18));
    }
    .node rect { rx: 14px; ry: 14px; }
    .cluster rect { rx: 18px; ry: 18px; }
    .edgeLabel, .edgeLabel p, .edgeLabel span {
      background: #ffffff; color: #475569; border-radius: 999px;
    }
    .edgeLabel p { padding: 3px 10px; }
    .labelBkg { background: transparent !important; fill: none !important; }
---
flowchart TB
    Trigger("<b>External device</b>")
    Camera("<b>Canon EOS 5D Mark II</b>")

    subgraph Node["CAMERA NODE&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;"]
        GPhoto("<b>libgphoto2</b>")
        Driver("<b>CameraDriver</b><br/>its own thread")
        ROS{{"<b>CameraNode</b><br/>topics, services, parameters"}}
    end

    Clients(["<b>Other nodes</b><br/>rqt_image_view"])
    Folder[("<b>pictures/</b>")]
    Video("<b>web_video_server</b><br/>port 8081")
    Bridge("<b>rosbridge</b><br/>port 9091")
    Web("<b>web server</b><br/>port 8090")
    Page[("<b>web/dist</b><br/>the test page")]
    Browser(["<b>Web pages</b><br/>the test page"])

    Trigger -. "shutter release cable" .-> Camera
    Camera == "USB, PTP" ==> GPhoto
    GPhoto ==> Driver
    Driver ==> ROS
    ROS <-- "topics, services<br/>parameters" --> Clients
    ROS -. "saves" .-> Folder
    ROS == "preview/compressed" ==> Video
    ROS <--> Bridge
    Folder --> Web
    Page --> Web
    Video == "MJPEG" ==> Browser
    Bridge <-- "services, parameters<br/>picture" --> Browser
    Web == "the page, the pictures,<br/>the listings, the API" ==> Browser

    classDef human fill:#ffe4e6,stroke:#e11d48,stroke-width:2px,color:#881337
    classDef voice fill:#ccfbf1,stroke:#0d9488,stroke-width:2px,color:#134e4a
    classDef mind  fill:#ede9fe,stroke:#7c3aed,stroke-width:2px,color:#4c1d95
    classDef brain fill:#7c3aed,stroke:#5b21b6,stroke-width:2px,color:#ffffff
    classDef robot fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#78350f
    classDef data  fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#1e3a8a
    classDef ext   fill:#f1f5f9,stroke:#64748b,stroke-width:2px,color:#0f172a

    class Trigger,Camera robot
    class GPhoto,Driver mind
    class ROS brain
    class Clients ext
    class Folder,Page data
    class Video,Bridge,Web voice
    class Browser human

    style Node fill:#8b5cf612,stroke:#8b5cf6,stroke-width:1.5px,stroke-dasharray:6 5,color:#7c3aed

    linkStyle 0 stroke:#f59e0b,stroke-width:2px
    linkStyle 1,2,3,6,10,12 stroke:#14b8a6,stroke-width:3px
    linkStyle 4,7,11 stroke:#8b5cf6,stroke-width:2px
    linkStyle 5,8,9 stroke:#3b82f6,stroke-width:2px
