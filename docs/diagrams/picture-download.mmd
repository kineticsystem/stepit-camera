---
config:
  theme: base
  fontFamily: "Arial, Helvetica, sans-serif"
  sequence:
    actorMargin: 24
    width: 130
    diagramMarginX: 10
    boxMargin: 12
    boxTextMargin: 8
    messageMargin: 40
    noteMargin: 22
    labelBoxWidth: 56
    labelBoxHeight: 28
    messageFontSize: 16
    actorFontSize: 16
    noteFontSize: 15
    wrap: false
  themeVariables:
    textColor: "#8b5cf6"
    actorBkg: "#ede9fe"
    actorBorder: "#7c3aed"
    actorTextColor: "#4c1d95"
    actorLineColor: "#a78bfa"
    signalColor: "#8b949e"
    signalTextColor: "#6e7781"
    labelBoxBkgColor: "#ccfbf1"
    labelBoxBorderColor: "#0d9488"
    labelTextColor: "#134e4a"
    loopTextColor: "#0d9488"
    noteBkgColor: "#fef3c7"
    noteBorderColor: "#d97706"
    noteTextColor: "#78350f"
    activationBkgColor: "#c4b5fd"
    activationBorderColor: "#7c3aed"
    mainBkg: "#ede9fe"
    nodeBorder: "#7c3aed"
    secondaryColor: "#ede9fe"
    secondaryBorderColor: "#7c3aed"
    secondaryTextColor: "#4c1d95"
    tertiaryColor: "#ede9fe"
    tertiaryBorderColor: "#7c3aed"
    tertiaryTextColor: "#4c1d95"
  themeCSS: >
    svg, .label, .nodeLabel, .edgeLabel, foreignObject div { font-family: Arial, Helvetica, sans-serif; }
    .actor { filter: drop-shadow(0 3px 6px rgba(15, 23, 42, 0.18)); }
    rect.actor { rx: 12px; ry: 12px; }
---
sequenceDiagram
    participant Device as External device
    participant Camera
    participant Driver as CameraDriver
    participant Node as CameraNode

    Device ->> Camera: closes the shutter<br/>release contact
    Camera ->> Camera: stores IMG_0042.JPG
    Driver ->> Camera: waitForFiles()
    Camera -->> Driver: file added:<br/>IMG_0042.JPG
    Driver ->> Camera: download(IMG_0042.JPG)
    Camera -->> Driver: content
    opt keep_on_camera is false
        Driver ->> Camera: remove(IMG_0042.JPG)
    end
    Driver ->> Node: on_picture
    Node ->> Node: save into<br/>download_directory/folder
    Node -->> Node: publish ~/picture
